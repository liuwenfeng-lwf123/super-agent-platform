# =============================================================================
# Super Agent Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM API Keys (at least one required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Application ---
APP_NAME=Super Agent Platform
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Data Directories ---
DATA_DIR=./data
MEMORY_DIR=./data/memory
THREADS_DIR=./data/threads

# --- Sandbox Mode ---
# "local" = run code on host (default), "docker" = run in isolated containers
SANDBOX_MODE=local
# DOCKER_RUNTIME_PYTHON_IMAGE=super-agent-sandbox  # or python:3.11-slim
# DOCKER_RUNTIME_NODE_IMAGE=node:20-bookworm-slim
# DOCKER_RUNTIME_NETWORK=bridge     # "none" for full isolation
# DOCKER_RUNTIME_MEMORY=1g
# DOCKER_RUNTIME_CPUS=1.0

# --- Budget ---
MAX_BUDGET_USD=10.0

# --- Local Mode ---
LOCAL_MODE_ENABLED=false
LOCAL_ALLOWED_DIRS=/Users/you/projects

# --- MCP Servers (JSON array, optional) ---
# MCP_SERVERS=[{"name":"example","url":"http://localhost:8080"}]

# --- IM Channels (optional — set tokens to auto-start transports) ---

# Feishu / Lark (WebSocket long-connection, no public IP needed)
# FEISHU_APP_ID=cli_xxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_DOMAIN=https://open.feishu.cn   # or https://open.larksuite.com

# WeCom AI Bot (WebSocket)
# WECOM_BOT_ID=your_bot_id
# WECOM_BOT_SECRET=your_bot_secret

# Slack (Socket Mode, no public URL needed)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=              # comma-separated user IDs, empty = allow all

# Telegram (webhook mode)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_WEBHOOK_SECRET=optional_secret

# --- Observability ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxxx
# LANGSMITH_PROJECT=super-agent

# LANGFUSE_TRACING=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Production Settings ---
# WORKERS=4
# TIMEOUT=120
# MAX_REQUESTS=1000
